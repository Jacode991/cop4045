def find_P(n):
  triples = []

  for a in range(1, n + 1):
    for b in range(a, n + 1):
      for c in range(b, n + 1):

        if a**2 + b**2 == c**2:
          triples.append((a, b, c))

  return triples

n = int(input("Enter a positive integer n: "))

result = find_P(n)

for triple in result:
  print(triple)
