def caesar_cipher(text, shift):
    """Encrypt text using a Caesar cipher with the given shift."""
    alphabet_lower = "abcdefghijklmnopqrstuvwxyz"
    alphabet_upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    encrypted_text = ""

    for char in text:
        if char in alphabet_lower:
            index = alphabet_lower.index(char)
            new_index = (index + shift) % 26
            encrypted_text += alphabet_lower[new_index]

        elif char in alphabet_upper:
            index = alphabet_upper.index(char)
            new_index = (index + shift) % 26
            encrypted_text += alphabet_upper[new_index]

        else:
            encrypted_text += char

    return encrypted_text


def caesar_decipher(cyphertext, shift):
    """Decrypt text that was encrypted using a Caesar cipher."""
    return caesar_cipher(cyphertext, -shift)


def letter_frequency(text):
    """Count the frequency of each letter, ignoring case."""
    alphabet = "abcdefghijklmnopqrstuvwxyz"
    frequencies = {}

    for letter in alphabet:
        frequencies[letter] = 0

    for char in text:
        char = char.lower()

        if char in alphabet:
            frequencies[char] += 1

    return frequencies


def main():
    """Run the interactive Caesar cipher program."""
    print("Caesar Cipher Program")
    print("---------------------")

    message = input("Enter a message: ")
    shift = int(input("Enter shift value: "))

    ciphered_text = caesar_cipher(message, shift)

    print("\nCiphered text:")
    print(ciphered_text)

    frequencies = letter_frequency(message)

    print("\nLetter frequency:")
    for letter in frequencies:
        print("{}: {}".format(letter, frequencies[letter]))

    deciphered_text = caesar_decipher(ciphered_text, shift)

    print("\nDeciphered text:")
    print(deciphered_text)


if __name__ == "__main__":
    main()
